{
  "name": "patchtoy",
  "version": "2.0.0",
  "description": "Node-based GLSL shader editor",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_API_URL=http://localhost:8787 vite",
    "build": "vite build",
    "preview": "vite preview",
    "mcp": "node mcp/server.mjs",
    "mcp:cli": "node mcp/cli.mjs",
    "test:mcp": "node mcp/test-e2e.mjs",
    "thumbs": "node scripts/make-thumbs.mjs",
    "mock-api": "node scripts/mock-api.mjs --seed",
    "io-bridge": "node scripts/io-bridge.mjs",
    "osc-demo": "node scripts/osc-send-demo.mjs",
    "test:community": "node scripts/e2e-community.mjs",
    "test:lambda": "npm test --prefix infra/lambda",
