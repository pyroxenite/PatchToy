  "customNodes": {
    "FloorUV": {
      "category": "custom",
      "inputs": [
        {
          "name": "p",
          "type": "vec2",
          "paramName": "p"
        },
        {
          "name": "horizon",
          "type": "float",
          "paramName": "horizon"
        },
        {
          "name": "height",
          "type": "float",
          "paramName": "height"
        },
        {
          "name": "spread",
          "type": "float",
          "paramName": "spread"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec4"
        }
      ],
      "customGLSL": "// @node floorUV\n// @title Floor UV\n// @category custom\n// @description Perspective floor below the horizon, mapped to spectrogram coordinates: x = time (1 = now at the bottom edge, 0 = the oldest row at the horizon), y = frequency (lows down the middle, highs to the sides, mirrored). z = floor mask, w = depth 0 (near) .. 1 (far). Wire .xy into an Audio Texture (spectrogram) uv input.\nvec4 floorUV(vec2 p, float horizon, float height, float spread) {\n    float d = horizon - p.y;\n    if (d <= 0.0) return vec4(0.0, 0.0, 0.0, 1.0);\n    float zNear = height / (horizon + 1.0);\n    float zFar = 14.0 * height;\n    float z = height / d;\n    float depth = clamp((z - zNear) / (zFar - zNear), 0.0, 1.0);\n    float x = p.x * z;\n    float freq = clamp(abs(x) / max(spread, 0.01), 0.0, 1.0);\n    float mask = smoothstep(0.0, 0.015, d);\n    return vec4(1.0 - depth, freq, mask, depth);\n}\n"
    },
    "FloorShade": {
      "category": "custom",
      "inputs": [
        {
          "name": "f",
          "type": "vec4",
          "paramName": "f"
        },
        {
          "name": "level",
          "type": "float",
          "paramName": "level"
        },
        {
          "name": "colorA",
          "type": "vec3",
          "paramName": "colorA"
        },
        {
          "name": "colorB",
          "type": "vec3",
          "paramName": "colorB"
        },
        {
          "name": "glow",
          "type": "float",
          "paramName": "glow"
        },
        {
          "name": "history",
          "type": "float",
          "paramName": "history"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec3"
        }
      ],
      "customGLSL": "// @node floorShade\n// @title Floor Shade\n// @category custom\n// @description Shades the spectrogram floor: level (Audio Texture value) through a two-colour heat ramp with white-hot peaks, a grid that scrolls toward the viewer with the history (lines every half second and every 1/16 of the frequency axis), fog to the horizon. f = Floor UV output.\nvec3 floorShade(vec4 f, float level, vec3 colorA, vec3 colorB, float glow, float history) {\n    if (f.z <= 0.0) return vec3(0.0);\n    float v = smoothstep(0.24, 0.95, clamp(level, 0.0, 1.0));\n    vec3 heat = mix(colorA, colorB, smoothstep(0.1, 0.65, v)) * v * v * glow * 1.3;\n    heat += vec3(1.0, 0.95, 0.9) * smoothstep(0.75, 1.0, v) * 0.7 * glow;\n    float age = (1.0 - f.x) * history;\n    float tt = (u_time - age) * 2.0;\n    float ff = f.y * 16.0;\n    float lt = abs(fract(tt) - 0.5);\n    float lf = abs(fract(ff) - 0.5);\n    float gt = smoothstep(0.5 - 1.5 * fwidth(tt), 0.5, lt);\n    float gf = smoothstep(0.5 - 1.5 * fwidth(ff), 0.5, lf);\n    float grid = max(gt, gf) * (0.45 + 0.8 * v);\n    float fade = pow(1.0 - f.w, 1.4);\n    vec3 haze = mix(colorA, colorB, 0.5) * 0.035 * smoothstep(0.5, 1.0, f.w);\n    return ((heat + grid * mix(colorA, colorB, 0.3) * 0.3) * fade + haze) * f.z;\n}\n"
    },
    "AudioSky": {
      "category": "custom",
      "inputs": [
        {
          "name": "p",
          "type": "vec2",
          "paramName": "p"
        },
        {
          "name": "horizon",
          "type": "float",
          "paramName": "horizon"
        },
        {
          "name": "sunC",
          "type": "vec2",
          "paramName": "sunC"
        },
        {
          "name": "sunR",
          "type": "float",
          "paramName": "sunR"
        },
        {
          "name": "colorA",
          "type": "vec3",
          "paramName": "colorA"
        },
        {
          "name": "colorB",
          "type": "vec3",
          "paramName": "colorB"
        },
        {
          "name": "bass",
          "type": "float",
          "paramName": "bass"
        },
        {
          "name": "kick",
          "type": "float",
          "paramName": "kick"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec3"
        }
      ],
      "customGLSL": "// @node audioSky\n// @title Audio Sky\n// @category custom\n// @description Night sky above the horizon: deep gradient, a coloured glow band on the horizon that swells with the bass, twinkling stars, and a striped retro sun behind the ring centre (radius sunR) that flashes on the kick.\nvec3 audioSky(vec2 p, float horizon, vec2 sunC, float sunR, vec3 colorA, vec3 colorB, float bass, float kick) {\n    float h = p.y - horizon;\n    vec3 col = mix(vec3(0.05, 0.015, 0.08), vec3(0.004, 0.006, 0.02), smoothstep(0.0, 1.0, h)) * step(0.0, h);\n    col += mix(colorB, colorA, 0.3) * 0.14 * exp(-(h > 0.0 ? h * 7.0 : -h * 40.0)) * (0.5 + 0.8 * bass);\n    vec2 g = floor(p * 70.0);\n    float r = fract(sin(dot(g, vec2(12.9898, 78.233))) * 43758.5453);\n    vec2 c = fract(p * 70.0) - 0.5 - (vec2(fract(r * 13.7), fract(r * 7.3)) - 0.5) * 0.6;\n    float star = step(0.97, r) * smoothstep(0.12, 0.0, length(c)) * smoothstep(0.02, 0.3, h) * 1.6;\n    col += star * (0.5 + 0.5 * sin(u_time * 2.3 + r * 60.0)) * vec3(0.8, 0.85, 1.0);\n    float d = length(p - sunC);\n    float sun = smoothstep(sunR, sunR - 0.006, d);\n    float yy = (p.y - sunC.y) / sunR;\n    float stripes = step(0.0, sin((yy + u_time * 0.05) * 40.0 + 1.0)) + step(0.15, yy);\n    sun *= clamp(stripes, 0.0, 1.0);\n    vec3 sunCol = mix(colorB * 1.2, vec3(1.0, 0.75, 0.35), smoothstep(-0.9, 0.8, yy));\n    col += sun * sunCol * (0.55 + 0.6 * kick) * step(0.0, h);\n    col += sunCol * 0.18 * exp(-max(d - sunR, 0.0) * 9.0) * step(0.0, h) * (0.6 + 0.6 * kick);\n    return col;\n}\n"
    },
    "AudioCompose": {
      "category": "custom",
      "inputs": [
        {
          "name": "sky",
          "type": "vec3",
          "paramName": "sky"
        },
        {
          "name": "floorCol",
          "type": "vec3",
          "paramName": "floorCol"
        },
        {
          "name": "ringMask",
          "type": "float",
          "paramName": "ringMask"
        },
        {
          "name": "ringCap",
          "type": "float",
          "paramName": "ringCap"
        },
        {
          "name": "ringLevel",
          "type": "float",
          "paramName": "ringLevel"
        },
        {
          "name": "ringLine",
          "type": "float",
          "paramName": "ringLine"
        },
        {
          "name": "waveLine",
          "type": "float",
          "paramName": "waveLine"
        },
        {
          "name": "waveGlow",
          "type": "float",
          "paramName": "waveGlow"
        },
        {
          "name": "colorA",
          "type": "vec3",
          "paramName": "colorA"
        },
        {
          "name": "colorB",
          "type": "vec3",
          "paramName": "colorB"
        },
        {
          "name": "ringGain",
          "type": "float",
          "paramName": "ringGain"
        },
        {
          "name": "waveGain",
          "type": "float",
          "paramName": "waveGain"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec3"
        }
      ],
      "customGLSL": "// @node audioCompose\n// @title Audio Compose\n// @category custom\n// @description Layers the visualiser in HDR: sky, the spectrogram floor, the waveform line on the horizon (core + glow) and the circular spectrum (bars coloured by level, white peak caps, inner ring line). Wire the Circular Spectrum outputs (mask, cap, level, ring) and the Waveform Line outputs (line, glow).\nvec3 audioCompose(vec3 sky, vec3 floorCol, float ringMask, float ringCap, float ringLevel, float ringLine, float waveLine, float waveGlow, vec3 colorA, vec3 colorB, float ringGain, float waveGain) {\n    vec3 col = sky + floorCol;\n    vec3 barCol = mix(colorA, colorB, smoothstep(0.15, 0.9, ringLevel));\n    col = mix(col, barCol * (0.7 + 1.8 * ringLevel) * ringGain, ringMask);\n    col += vec3(1.0, 0.95, 0.9) * ringCap * 1.5 * ringGain;\n    col += colorA * ringLine * 0.9 * ringGain;\n    vec3 wc = mix(colorA, vec3(1.0), 0.4);\n    col += (wc * waveLine * 1.7 + colorA * waveGlow * 0.3) * waveGain;\n    return col;\n}\n"
    }
