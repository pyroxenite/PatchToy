  "customNodes": {
    "StormSim": {
      "category": "custom",
      "inputs": [
        {
          "name": "state",
          "type": "sampler2D",
          "paramName": "state"
        },
        {
          "name": "time",
          "type": "float",
          "paramName": "time"
        },
        {
          "name": "speed",
          "type": "float",
          "paramName": "speed"
        },
        {
          "name": "vortex",
          "type": "float",
          "paramName": "vortex"
        },
        {
          "name": "turbulence",
          "type": "float",
          "paramName": "turbulence"
        },
        {
          "name": "drive",
          "type": "float",
          "paramName": "drive"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec4"
        }
      ],
      "customGLSL": "/*\n * @node stormSim\n * @title Storm Sim\n * @category custom\n * @description Particle storm in one rgba32f / nearest Feedback of W x 2H texels: rows 0..H-1 = position (w = remaining life, s), rows H..2H-1 = velocity. A vortex around the Y axis with an inward pull and an updraft, curl-like turbulence and drag; particles respawn on a ring when their life runs out (staggered at start). drive (music) speeds the storm up and stirs it.\n */\nfloat stm_hash(vec2 p) {\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nvec3 stm_field(vec3 p) {\n    return vec3(sin(p.y * 1.3 + cos(p.z * 1.7)), sin(p.z * 1.1 + cos(p.x * 1.9)), sin(p.x * 1.5 + cos(p.y * 1.2)));\n}\n\nvec3 stm_curl(vec3 p) {\n    const float e = 0.1;\n    vec3 dx = stm_field(p + vec3(e, 0.0, 0.0)) - stm_field(p - vec3(e, 0.0, 0.0));\n    vec3 dy = stm_field(p + vec3(0.0, e, 0.0)) - stm_field(p - vec3(0.0, e, 0.0));\n    vec3 dz = stm_field(p + vec3(0.0, 0.0, e)) - stm_field(p - vec3(0.0, 0.0, e));\n    return vec3(dy.z - dz.y, dz.x - dx.z, dx.y - dy.x) / (2.0 * e);\n}\n\nvec4 stormSim(sampler2D state, float time, float speed, float vortex, float turbulence, float drive) {\n    ivec2 sz = textureSize(state, 0);\n    int W = sz.x;\n    int H = max(sz.y / 2, 1);\n    ivec2 p = ivec2(gl_FragCoord.xy);\n    bool velRow = p.y >= H;\n    ivec2 ip = ivec2(p.x, velRow ? p.y - H : p.y);\n    float id = float(ip.y * W + ip.x);\n    vec4 P = texelFetch(state, ip, 0);\n    vec4 V = texelFetch(state, ip + ivec2(0, H), 0);\n    float dt = 1.0 / 60.0;\n    float life = P.w - dt;\n    if (P.w <= 0.0 || life <= 0.0) {\n        float seed = id + floor(time * 7.0) * 1.618;\n        float a = stm_hash(vec2(seed, 1.3)) * 6.2831853;\n        float r = 3.5 + 3.0 * stm_hash(vec2(seed, 7.7));\n        vec3 pos = vec3(cos(a) * r, (stm_hash(vec2(seed, 4.1)) - 0.5) * 1.2 - 2.0, sin(a) * r);\n        float l = (P.w <= 0.0 ? stm_hash(vec2(id, 9.9)) : 1.0) * (3.0 + 5.0 * stm_hash(vec2(seed, 2.2)));\n        vec3 vel = vec3(-sin(a), 0.2, cos(a)) * speed * 0.6;\n        return velRow ? vec4(vel, 0.0) : vec4(pos, max(l, 0.05));\n    }\n    if (!velRow) return vec4(P.xyz + V.xyz * dt, life);\n    vec3 pos = P.xyz;\n    float rr = length(pos.xz) + 0.05;\n    vec3 tang = vec3(-pos.z, 0.0, pos.x) / rr;\n    float swirl = vortex * speed * 3.2 * smoothstep(0.0, 1.2, rr) / sqrt(rr + 0.5) * (1.0 + 0.5 * drive);\n    vec3 target = tang * swirl\n                + vec3(-pos.x, 0.0, -pos.z) * 0.22 * speed\n                + vec3(0.0, speed * (1.6 * exp(-rr * 0.45) - 0.25 * pos.y * 0.3), 0.0)\n                + stm_curl(pos * 0.45 + vec3(0.0, time * 0.25, 0.0)) * turbulence * (1.0 + drive) * speed * 0.6;\n    if (length(pos) > 11.0) target -= pos * 0.5;\n    vec3 vel = mix(V.xyz, target, 1.0 - exp(-dt * 2.5));\n    return vec4(vel, 0.0);\n}"
    },
    "BrightPass": {
      "category": "custom",
      "inputs": [
        {
          "name": "tex",
          "type": "sampler2D",
          "paramName": "tex"
        },
        {
          "name": "threshold",
          "type": "float",
          "paramName": "threshold"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec4"
        }
      ],
      "customGLSL": "/*\n * @node brightPass\n * @title Bright Pass\n * @category custom\n * @description The bright parts of a texture (luma above threshold), averaged over 4 taps: render it into a small Feedback for bloom.\n */\nvec4 brightPass(sampler2D tex, float threshold) {\n    vec2 uv = gl_FragCoord.xy / u_resolution;\n    vec2 px = 1.0 / vec2(textureSize(tex, 0));\n    vec3 c = texture(tex, uv + px * vec2(-1.0, -1.0)).rgb + texture(tex, uv + px * vec2(1.0, -1.0)).rgb\n           + texture(tex, uv + px * vec2(-1.0, 1.0)).rgb + texture(tex, uv + px * vec2(1.0, 1.0)).rgb;\n    c *= 0.25;\n    float l = dot(c, vec3(0.2126, 0.7152, 0.0722));\n    return vec4(c * smoothstep(threshold, threshold + 0.35, l), 1.0);\n}"
    },
    "BloomGrade": {
      "category": "custom",
      "inputs": [
        {
          "name": "scene",
          "type": "sampler2D",
          "paramName": "scene"
        },
        {
          "name": "bloom",
          "type": "sampler2D",
          "paramName": "bloom"
        },
        {
          "name": "amount",
          "type": "float",
          "paramName": "amount"
        },
        {
          "name": "vignette",
          "type": "float",
          "paramName": "vignette"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec3"
        }
      ],
      "customGLSL": "/*\n * @node bloomGrade\n * @title Bloom Grade\n * @category custom\n * @description Adds a soft 7x7 bloom of the bright pass to the scene, then a vignette and a gentle highlight roll-off.\n */\nvec3 bloomGrade(sampler2D scene, sampler2D bloom, float amount, float vignette) {\n    vec2 uv = gl_FragCoord.xy / u_resolution;\n    vec3 c = texture(scene, uv).rgb;\n    vec2 px = 1.0 / vec2(textureSize(bloom, 0));\n    vec3 b = vec3(0.0);\n    float ws = 0.0;\n    for (int y = -3; y <= 3; y++) {\n        for (int x = -3; x <= 3; x++) {\n            float w = exp(-float(x * x + y * y) / 5.0);\n            b += texture(bloom, uv + vec2(float(x), float(y)) * px).rgb * w;\n            ws += w;\n        }\n    }\n    c += b / ws * amount;\n    float r = length((uv - 0.5) * vec2(1.0, 0.75));\n    c *= mix(1.0, smoothstep(0.9, 0.2, r), vignette);\n    return 1.0 - exp(-c * 1.4);\n}"
    }
  },
