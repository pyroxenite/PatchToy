  "customNodes": {
    "BuggyGlow": {
      "category": "custom",
      "inputs": [
        {
          "name": "UV",
          "type": "vec2",
          "paramName": "uv"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec3"
        }
      ],
      "customGLSL": "/* \n * @node buggyGlow\n * @title buggyGlow\n * @category custom\n * \n * @input uv \"UV\"\n * \n * @description\n */\n\n// A glow around a ring with a bug: inside the ring d < 0 and\n// pow(negative, 0.5) is NaN -> the disk renders black.\n// Fix: pow(abs(d), 0.5)\nvec3 buggyGlow(vec2 uv) {\n    float d = length(uv - 0.5) - 0.2;\n    return vec3(1.0, 0.55, 0.2) * 0.06 / pow(d, 0.5);\n}"
    },
    "Lissajous": {
      "category": "custom",
      "inputs": [
        {
          "name": "T",
          "type": "float",
          "paramName": "t"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec2"
        }
      ],
      "customGLSL": "/* \n * @node lissajous\n * @title lissajous\n * @category custom\n * \n * @input t \"T\"\n * \n * @description\n */\n\n// A 3:2 Lissajous figure traced over time\nvec2 lissajous(float t) {\n    return vec2(sin(3.0 * t), sin(2.0 * t + 0.6));\n}"
    }
  },
