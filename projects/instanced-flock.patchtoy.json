  "customNodes": {
    "FlockSim": {
      "category": "custom",
      "inputs": [
        {
          "name": "state",
          "type": "sampler2D",
          "paramName": "state"
        },
        {
          "name": "time",
          "type": "float",
          "paramName": "time"
        },
        {
          "name": "separation",
          "type": "float",
          "paramName": "separation"
        },
        {
          "name": "alignment",
          "type": "float",
          "paramName": "alignment"
        },
        {
          "name": "cohesion",
          "type": "float",
          "paramName": "cohesion"
        },
        {
          "name": "speed",
          "type": "float",
          "paramName": "speed"
        },
        {
          "name": "radius",
          "type": "float",
          "paramName": "radius"
        },
        {
          "name": "bounds",
          "type": "float",
          "paramName": "bounds"
        },
        {
          "name": "drive",
          "type": "float",
          "paramName": "drive"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec4"
        }
      ],
      "customGLSL": "/*\n * @node flockSim\n * @title Flock Sim\n * @category custom\n * @description Euclidean boids in one rgba32f / nearest Feedback of W x 2H texels: rows 0..H-1 hold the positions (w = 1 once initialised), rows H..2H-1 the velocities (w = a per-bird speed factor). Each velocity texel visits every boid within radius: separation, alignment, cohesion, plus a wandering attractor, a soft spherical boundary and the ground. Positions advance with last frame's velocity (fixed 60 Hz step). drive (music) bursts the separation and speeds the flock up.\n */\nfloat flk_hash(vec2 p) {\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nvec3 flk_hash3(float n) {\n    return vec3(flk_hash(vec2(n, 1.7)), flk_hash(vec2(n, 9.2)), flk_hash(vec2(n, 27.1)));\n}\n\nvec4 flockSim(sampler2D state, float time, float separation, float alignment, float cohesion, float speed, float radius, float bounds, float drive) {\n    ivec2 sz = textureSize(state, 0);\n    int W = sz.x;\n    int H = max(sz.y / 2, 1);\n    ivec2 p = ivec2(gl_FragCoord.xy);\n    bool velRow = p.y >= H;\n    ivec2 ip = ivec2(p.x, velRow ? p.y - H : p.y);\n    float id = float(ip.y * W + ip.x);\n    vec4 P = texelFetch(state, ip, 0);\n    vec4 V = texelFetch(state, ip + ivec2(0, H), 0);\n    vec3 home = vec3(0.0, bounds * 0.75, 0.0);\n    if (P.w < 0.5) {\n        vec3 r = flk_hash3(id) * 2.0 - 1.0;\n        vec3 vel = normalize(flk_hash3(id + 91.0) * 2.0 - 1.0 + vec3(1e-4)) * speed;\n        return velRow ? vec4(vel, 0.8 + 0.4 * flk_hash(vec2(id, 3.3))) : vec4(home + r * bounds * 0.5, 1.0);\n    }\n    float dt = 1.0 / 60.0;\n    if (!velRow) return vec4(P.xyz + V.xyz * dt, 1.0);\n    vec3 pos = P.xyz;\n    vec3 vel = V.xyz;\n    vec3 sep = vec3(0.0);\n    vec3 avgV = vec3(0.0);\n    vec3 avgP = vec3(0.0);\n    float n = 0.0;\n    float r2 = radius * radius;\n    float rs = radius * 0.45;\n    int N = W * H;\n    for (int j = 0; j < 8192; j++) {\n        if (j >= N) break;\n        ivec2 q = ivec2(j % W, j / W);\n        vec3 pj = texelFetch(state, q, 0).xyz;\n        vec3 d = pj - pos;\n        float d2 = dot(d, d);\n        if (d2 < r2 && d2 > 1e-8) {\n            vec3 vj = texelFetch(state, q + ivec2(0, H), 0).xyz;\n            n += 1.0;\n            avgV += vj;\n            avgP += pj;\n            float dl = sqrt(d2);\n            if (dl < rs) sep -= d / dl * (rs - dl) / rs;\n        }\n    }\n    vec3 acc = vec3(0.0);\n    if (n > 0.0) {\n        acc += sep * separation * (5.0 + 8.0 * drive);\n        acc += (avgV / n - vel) * alignment * 1.4;\n        acc += (avgP / n - pos) * cohesion * 0.7;\n    }\n    vec3 att = home + vec3(sin(time * 0.21) * 0.55, sin(time * 0.33) * 0.3, cos(time * 0.17) * 0.55) * bounds;\n    acc += (att - pos) * 0.08;\n    vec3 c = pos - home;\n    float l = length(c);\n    if (l > bounds) acc -= c / l * (l - bounds) * 2.5;\n    if (pos.y < 1.5) acc.y += (1.5 - pos.y) * 8.0;\n    vel += acc * dt;\n    float target = speed * V.w * (1.0 + 0.35 * drive);\n    float s = max(length(vel), 1e-4);\n    vel = vel / s * clamp(mix(s, target, 0.04), target * 0.6, target * 1.6);\n    return vec4(vel, V.w);\n}"
    },
    "WingFlap": {
      "category": "custom",
      "inputs": [
        {
          "name": "vertexColor",
          "type": "vec4",
          "paramName": "vertexColor"
        },
        {
          "name": "id",
          "type": "float",
          "paramName": "id"
        },
        {
          "name": "time",
          "type": "float",
          "paramName": "time"
        },
        {
          "name": "rate",
          "type": "float",
          "paramName": "rate"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec3"
        }
      ],
      "customGLSL": "/*\n * @node wingFlap\n * @title Wing Flap\n * @category custom\n * @description Vertex offset that flaps the wings of a Bird Mesh: the wing weight lives in the vertex colour alpha (0 on the body, +-1 at the tips); each bird flaps at its own phase (instance id). Wire into Mesh.displace.\n */\nvec3 wingFlap(vec4 vertexColor, float id, float time, float rate) {\n    float w = abs(vertexColor.a);\n    float ph = time * rate * (0.85 + 0.3 * fract(id * 0.618)) + id * 1.37;\n    return vec3(0.0, w * sin(ph) * 0.42, -w * 0.06 * cos(ph));\n}"
    },
    "FlockSky": {
      "category": "custom",
      "inputs": [
        {
          "name": "rd",
          "type": "vec3",
          "paramName": "rd"
        },
        {
          "name": "horizon",
          "type": "vec3",
          "paramName": "horizon"
        },
        {
          "name": "zenith",
          "type": "vec3",
          "paramName": "zenith"
        },
        {
          "name": "sunDir",
          "type": "vec3",
          "paramName": "sunDir"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec4"
        }
      ],
      "customGLSL": "/*\n * @node flockSky\n * @title Flock Sky\n * @category custom\n * @description Sky behind the flock for a camera ray rd: horizon to zenith gradient and a sun glow towards sunDir.\n */\nvec4 flockSky(vec3 rd, vec3 horizon, vec3 zenith, vec3 sunDir) {\n    float h = clamp(rd.y, -1.0, 1.0);\n    vec3 c = mix(horizon, zenith, pow(smoothstep(-0.02, 0.65, h), 0.7));\n    float s = max(dot(rd, normalize(sunDir)), 0.0);\n    c += vec3(1.0, 0.82, 0.55) * (pow(s, 90.0) * 2.5 + pow(s, 8.0) * 0.3);\n    return vec4(c, 1.0);\n}"
    },
    "BrightPass": {
      "category": "custom",
      "inputs": [
        {
          "name": "tex",
          "type": "sampler2D",
          "paramName": "tex"
        },
        {
          "name": "threshold",
          "type": "float",
          "paramName": "threshold"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec4"
        }
      ],
      "customGLSL": "/*\n * @node brightPass\n * @title Bright Pass\n * @category custom\n * @description The bright parts of a texture (luma above threshold), averaged over 4 taps: render it into a small Feedback for bloom.\n */\nvec4 brightPass(sampler2D tex, float threshold) {\n    vec2 uv = gl_FragCoord.xy / u_resolution;\n    vec2 px = 1.0 / vec2(textureSize(tex, 0));\n    vec3 c = texture(tex, uv + px * vec2(-1.0, -1.0)).rgb + texture(tex, uv + px * vec2(1.0, -1.0)).rgb\n           + texture(tex, uv + px * vec2(-1.0, 1.0)).rgb + texture(tex, uv + px * vec2(1.0, 1.0)).rgb;\n    c *= 0.25;\n    float l = dot(c, vec3(0.2126, 0.7152, 0.0722));\n    return vec4(c * smoothstep(threshold, threshold + 0.35, l), 1.0);\n}"
    },
    "BloomGrade": {
      "category": "custom",
      "inputs": [
        {
          "name": "scene",
          "type": "sampler2D",
          "paramName": "scene"
        },
        {
          "name": "bloom",
          "type": "sampler2D",
          "paramName": "bloom"
        },
        {
          "name": "amount",
          "type": "float",
          "paramName": "amount"
        },
        {
          "name": "vignette",
          "type": "float",
          "paramName": "vignette"
        }
      ],
      "outputs": [
        {
          "name": "",
          "type": "vec3"
        }
      ],
      "customGLSL": "/*\n * @node bloomGrade\n * @title Bloom Grade\n * @category custom\n * @description Adds a soft 7x7 bloom of the bright pass to the scene, then a vignette and a gentle highlight roll-off.\n */\nvec3 bloomGrade(sampler2D scene, sampler2D bloom, float amount, float vignette) {\n    vec2 uv = gl_FragCoord.xy / u_resolution;\n    vec3 c = texture(scene, uv).rgb;\n    vec2 px = 1.0 / vec2(textureSize(bloom, 0));\n    vec3 b = vec3(0.0);\n    float ws = 0.0;\n    for (int y = -3; y <= 3; y++) {\n        for (int x = -3; x <= 3; x++) {\n            float w = exp(-float(x * x + y * y) / 5.0);\n            b += texture(bloom, uv + vec2(float(x), float(y)) * px).rgb * w;\n            ws += w;\n        }\n    }\n    c += b / ws * amount;\n    float r = length((uv - 0.5) * vec2(1.0, 0.75));\n    c *= mix(1.0, smoothstep(0.9, 0.2, r), vignette);\n    return 1.0 - exp(-c * 1.4);\n}"
    }
  },
