# Copy this file to .env and fill in your hosted zone details
# Route 53 hosted zone ID for patchtoy.com
hostedZoneId=Z1234567890ABC

# Root domain name
zoneName=patchtoy.com

# Optional subdomain (leave blank to use apex). Example: www
siteSubdomain=www

# Backend deployment (optional)
# Set to 'true' to deploy API Gateway, Lambda, and DynamoDB
DEPLOY_BACKEND=false

# JWT secret for authentication (REQUIRED if backend is enabled)
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production

# API Key requirement (optional, additional security layer)
REQUIRE_API_KEY=false

# Email-verification sign-up (default on). Set to false only while SES is in sandbox mode
# (accounts are then created at once and register says "Email already in use" again).
# SIGNUP_EMAIL_VERIFICATION=false

# Social link previews for /p/<id> and /u/<name> (Lambda@Edge in us-east-1, off by default).
# Needs `cdk bootstrap aws://<account>/us-east-1` once. See RELEASE.md step 8.
# ENABLE_SOCIAL_PREVIEWS=true
# SOCIAL_PREVIEW_API_URL=https://xxxxxxxxxx.execute-api.eu-west-3.amazonaws.com/prod
# SOCIAL_PREVIEWS_UNLISTED=true
# SOCIAL_PREVIEW_IMAGE_ORIGINS=https://dxxxxxxxxxxxx.cloudfront.net
# SOCIAL_PREVIEW_DEFAULT_IMAGE=https://patchtoy.com/og.png
